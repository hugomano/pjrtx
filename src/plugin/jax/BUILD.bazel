py_binary(
    name = "jax_upstream_subset",
    srcs = [
        "jax_upstream_subset.py",
    ],
    data = [
        "jax_upstream_allowlist.txt",
        "@jax_upstream//:source",
        "//src/plugin:pjrtx_metal_plugin",
    ],
    main = "jax_upstream_subset.py",
    deps = [
        ":pjrtx_pytest_plugin",
    ] + PYTEST_DEPS,
)

py_binary(
    name = "jax_upstream_all",
    srcs = [
        "jax_upstream_subset.py",
    ],
    args = ["--all-tests"],
    data = [
        "@jax_upstream//:source",
        "//src/plugin:pjrtx_metal_plugin",
    ],
    main = "jax_upstream_subset.py",
    deps = [
        ":pjrtx_pytest_plugin",
    ] + PYTEST_DEPS,
)

py_test(
    name = "jax_upstream_subset_test",
    srcs = [
        "jax_upstream_subset.py",
    ],
    data = [
        "jax_upstream_allowlist.txt",
        "@jax_upstream//:source",
        "//src/plugin:pjrtx_metal_plugin",
    ],
    env = {
        "PJRTX_BACKEND": "metal_mlx",
        "PJRTX_TRACE": "1",
    },
    main = "jax_upstream_subset.py",
    tags = ["manual"],
    deps = [
        ":pjrtx_pytest_plugin",
    ] + PYTEST_DEPS,
)


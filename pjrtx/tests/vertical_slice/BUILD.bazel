load("@rules_zig//zig:defs.bzl", "zig_test")

filegroup(
    name = "boundary_files",
    srcs = glob(["*.zig"]) + ["BUILD.bazel"],
    visibility = ["//pjrtx/tests/architecture:__pkg__"],
)

zig_test(
    name = "report_test",
    data = ["testdata/tiny_trace_report.txt"],
    main = "report_test.zig",
    srcs = ["runfiles.zig"],
    deps = [
        "//pjrtx/compiler/facts",
        "//pjrtx/core",
    ],
)


load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

filegroup(
    name = "boundary_files",
    srcs = glob(["*.zig"]) + ["BUILD.bazel"],
    visibility = ["//pjrtx/tests/architecture:__pkg__"],
)

zig_library(
    name = "backend",
    import_name = "pjrtx/backend",
    main = "backend.zig",
    visibility = ["//visibility:public"],
    deps = [
        "//pjrtx/compiler/facts",
        "//pjrtx/core",
        "//pjrtx/target",
    ],
)

zig_library(
    name = "mlir_bridge",
    import_name = "pjrtx/backend/mlir_bridge",
    main = "mlir_bridge.zig",
    visibility = ["//visibility:public"],
    deps = [
        ":backend",
        "//pjrtx/compiler/facts",
        "//pjrtx/compiler/mlir_state",
        "//pjrtx/core",
    ],
)

zig_test(
    name = "unit_tests",
    deps = [":backend"],
)

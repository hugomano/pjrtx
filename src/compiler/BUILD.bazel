load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

filegroup(
    name = "sources",
    srcs = [
        "BUILD.bazel",
        "compile_options.zig",
        "compiler.zig",
        "compiler_model.zig",
        "compiler_plan_tests.zig",
        "executable_plan_build.zig",
        "executable_plan_verify.zig",
        "executable_plan.zig",
        "ir.zig",
        "mlir_session.zig",
        "operation.zig",
        "plan_instruction.zig",
        "plan_memory.zig",
        "region.zig",
        "stablehlo_analysis_builder.zig",
        "stablehlo_decode.zig",
        "stablehlo_diagnostic.zig",
        "stablehlo_import.zig",
        "stablehlo_import_tests.zig",
        "stablehlo_module_import.zig",
        "stablehlo_operation_attrs.zig",
        "stablehlo_operation_import.zig",
        "stablehlo_region_import.zig",
        "stablehlo_sharding.zig",
        "stablehlo_topk_import.zig",
        "stablehlo_value_import.zig",
        "tensor.zig",
        "topology.zig",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "mlir_c_api",
    srcs = ["mlir_register.cc"],
    hdrs = ["mlir_c_api.h"],
    deps = [
        "@llvm-project//mlir:CAPIIR",
        "@llvm-project//mlir:CAPIShape",
        "@llvm-project//mlir:CAPITransforms",
        "@llvm-project//mlir:FuncExtensions",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:ShapeDialect",
        "@shardy//shardy/integrations/c:sdy_capi",
        "@stablehlo//:chlo_capi",
        "@stablehlo//:stablehlo_capi",
        "@stablehlo//:stablehlo_dialect_capi",
    ],
)

zig_library(
    name = "ir",
    import_name = "src/compiler/ir",
    main = "ir.zig",
    srcs = [
        "executable_plan.zig",
        "operation.zig",
        "region.zig",
        "tensor.zig",
        "topology.zig",
    ],
    visibility = ["//visibility:public"],
)

zig_library(
    name = "compiler",
    import_name = "src/compiler",
    main = "compiler.zig",
    srcs = [
        "compile_options.zig",
        "compiler_model.zig",
        "compiler_plan_tests.zig",
        "executable_plan_build.zig",
        "executable_plan_verify.zig",
        "mlir_session.zig",
        "plan_instruction.zig",
        "plan_memory.zig",
        "stablehlo_analysis_builder.zig",
        "stablehlo_decode.zig",
        "stablehlo_diagnostic.zig",
        "stablehlo_import.zig",
        "stablehlo_import_tests.zig",
        "stablehlo_module_import.zig",
        "stablehlo_operation_attrs.zig",
        "stablehlo_operation_import.zig",
        "stablehlo_region_import.zig",
        "stablehlo_sharding.zig",
        "stablehlo_topk_import.zig",
        "stablehlo_value_import.zig",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":mlir_c_api",
        ":ir",
    ],
)

zig_test(
    name = "compiler_test",
    deps = [":compiler"],
)

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

zig_library(
    name = "mlx_metal",
    import_name = "src/backend/mlx_metal",
    main = "backend.zig",
    srcs = [
        "async_transfer.zig",
        "buffer.zig",
        "custom_call.zig",
        "device.zig",
        "executable.zig",
        "execution.zig",
        "lowering.zig",
        "mlx_call.zig",
        "profiling.zig",
        "program.zig",
        "program_build.zig",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":api",
        "//src/compiler:ir",
    ],
)

zig_test(
    name = "mlx_metal_test",
    main = "backend.zig",
    srcs = [
        "async_transfer.zig",
        "buffer.zig",
        "custom_call.zig",
        "device.zig",
        "executable.zig",
        "execution.zig",
        "lowering.zig",
        "mlx_call.zig",
        "profiling.zig",
        "program.zig",
        "program_build.zig",
    ],
    deps = [
        ":api",
        "//src/compiler:ir",
    ],
)

cc_library(
    name = "api",
    srcs = ["api.cc"],
    hdrs = ["api.h"],
    visibility = ["//visibility:private"],
    copts = ["-std=c++20"],
    deps = [
        "@mlx_metal//:metal_runtime",
    ],
)

cc_test(
    name = "api_test",
    srcs = ["api_test.cc"],
    deps = [":api"],
)

cc_library(
    name = "vendor_probe",
    srcs = ["vendor_probe.cc"],
    hdrs = ["vendor_probe.h"],
    visibility = ["//visibility:private"],
    copts = ["-std=c++20"],
    deps = ["@mlx_metal//:metal_runtime"],
)

cc_test(
    name = "vendor_probe_test",
    srcs = ["vendor_probe_test.cc"],
    deps = [":vendor_probe"],
)

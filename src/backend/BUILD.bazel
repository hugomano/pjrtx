load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

zig_library(
    name = "backend",
    import_name = "src/backend",
    main = "backend.zig",
    visibility = ["//visibility:public"],
    deps = ["//src/core"],
)

zig_test(
    name = "backend_test",
    deps = [":backend"],
)

zig_library(
    name = "registry",
    import_name = "src/backend/registry",
    main = "registry.zig",
    visibility = ["//visibility:public"],
    deps = [
        ":backend",
        "//src/backend/mlx_metal:mlx_metal",
        "//src/backend/synthetic:synthetic",
        "//src/core",
    ],
)

zig_test(
    name = "registry_test",
    deps = [":registry"],
)

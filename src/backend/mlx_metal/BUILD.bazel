load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

zig_library(
    name = "mlx_metal",
    import_name = "src/backend/mlx_metal",
    main = "backend.zig",
    visibility = ["//src/backend:__pkg__"],
    deps = [
        ":api",
        "//src/backend",
        "//src/core",
    ],
)

zig_test(
    name = "mlx_metal_test",
    deps = [":mlx_metal"],
)

cc_library(
    name = "api",
    srcs = ["api.cc"],
    hdrs = ["api.h"],
    visibility = ["//visibility:private"],
    copts = ["-std=c++20"],
    deps = [
        "@mlx//:metal_runtime",
    ],
)

cc_test(
    name = "api_test",
    srcs = ["api_test.cc"],
    deps = [":api"],
)

cc_library(
    name = "vendor_probe",
    srcs = ["vendor_probe.cc"],
    hdrs = ["vendor_probe.h"],
    visibility = ["//visibility:private"],
    copts = ["-std=c++20"],
    deps = ["@mlx//:metal_runtime"],
)

cc_test(
    name = "vendor_probe_test",
    srcs = ["vendor_probe_test.cc"],
    deps = [":vendor_probe"],
)

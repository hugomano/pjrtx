load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

filegroup(
    name = "boundary_files",
    srcs = glob(["*.zig"]) + ["BUILD.bazel"],
    visibility = ["//pjrtx/tests/architecture:__pkg__"],
)

zig_library(
    name = "core",
    import_name = "pjrtx/core",
    main = "core.zig",
    visibility = ["//visibility:public"],
    deps = [
        "//pjrtx/compiler/facts",
        "//pjrtx/target",
    ],
)

zig_test(
    name = "unit_tests",
    deps = [":core"],
)

load("@rules_python//python/uv:lock.bzl", uv_lock = "lock")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

JAX_DEPS = [
    "@jax_sandbox_deps//jax:pkg",
]

PYTEST_DEPS = JAX_DEPS + [
    "@jax_sandbox_deps//absl_py:pkg",
    "@jax_sandbox_deps//flatbuffers:pkg",
    "@jax_sandbox_deps//hypothesis:pkg",
    "@jax_sandbox_deps//parameterized:pkg",
    "@jax_sandbox_deps//pytest:pkg",
]

py_library(
    name = "pjrtx_harness",
    srcs = [
        "jax_plugin_smoke.py",
        "pjrtx_harness.py",
    ],
    data = ["//src/plugin:pjrtx_metal_plugin"],
    deps = JAX_DEPS,
)

py_library(
    name = "pjrtx_pytest_plugin",
    srcs = [
        "pjrtx_pytest_plugin.py",
    ],
    deps = [
        ":pjrtx_harness",
    ] + PYTEST_DEPS,
)

py_binary(
    name = "jax_plugin_smoke",
    srcs = ["jax_plugin_smoke.py"],
    data = ["//src/plugin:pjrtx_metal_plugin"],
    main = "jax_plugin_smoke.py",
    deps = JAX_DEPS,
)

py_binary(
    name = "jax_llama_like_inference",
